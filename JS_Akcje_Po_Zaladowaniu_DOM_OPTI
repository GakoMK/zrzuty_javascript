// Ustawia domyslna walute
function walkText(node) {
    let domyslnaWaluta = GetValue('#{FLD:2401}#');
    let treeWalker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT, null, false);
    let currentNode;
    while (currentNode = treeWalker.nextNode()) {
        currentNode.data = currentNode.data.replace("[_waluta_]", domyslnaWaluta);
    }
}

// sprawdza czy kliknieto bilet i robi scroll to div
function czyBilety() {
    var spanElement = document.querySelector("#AttBool2 > div > div > div.col-sm-7.col-xs-12.ms-formbody.wfBesideRight.col-xs-height.full-height.th-frm-bg1.form-field-control.beside-panel__value > div > div.checkbox__wrapper > div > div > label > span.check-box__styled-input");
    if (spanElement) {
        console.log('Element został znaleziony.');
        spanElement.addEventListener('click', function() {
            var biletySection = document.querySelector("#biletySection");
            if (biletySection) {
                biletySection.scrollIntoView({ behavior: 'smooth' });
            }
        });
    } else {
        console.log('Element nie został znaleziony: sprawdza czy kliknieto bilet i robi scroll to div');
    }
}


