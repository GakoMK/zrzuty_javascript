console.log("Załadowano bezpieczną zmianę waluty JS+CSS");

function podmienWalutePrzezCSS() {
    // Pobranie wartości waluty z Twojego pola
    let domyslnaWaluta = GetValue('#{FLD:2401}#') || ""; 
    if (!domyslnaWaluta) return;

    // Pobiera wszystkie etykiety, labele, nagłówki tabel (standardowe klasy Webcon)
    let labels = document.querySelectorAll('label, .form-label, .ms-Label, th span');

    labels.forEach(label => {
        // Zapisujemy oryginalny tekst do naszego własnego atrybutu "data-oryginalny-tekst"
        let originalText = label.getAttribute('data-oryginalny-tekst');
        
        // Jeśli robimy to pierwszy raz dla danego elementu:
        if (!originalText) {
            originalText = label.innerText;
            // Interesują nas tylko te etykiety, które zawierają nasz znacznik
            if (originalText.includes('[_waluta_]')) {
                label.setAttribute('data-oryginalny-tekst', originalText);
            }
        }

        // Jeśli etykieta zawiera nasz znacznik, wykonujemy podmianę
        if (originalText && originalText.includes('[_waluta_]')) {
            let nowyTekst = originalText.replace('[_waluta_]', domyslnaWaluta);
            
            // Wpisujemy podmieniony tekst do ukrytego atrybutu (bez dotykania DOM i Reacta!)
            label.setAttribute('data-zastapiony-tekst', nowyTekst);
            // Dodajemy klasę, którą obsłużymy w CSS
            label.classList.add('waluta-podmieniona');
        }
    });
}

// Ochrona wydajności: Debounce dla MutationObservera
let timeoutId = null;
const observer = new MutationObserver(() => {
    if (timeoutId) {
        clearTimeout(timeoutId);
    }
    // Czekamy 50ms na zakończenie renderowania przez Webcona i odpalamy podmianę
    timeoutId = setTimeout(() => {
        podmienWalutePrzezCSS();
    }, 50); 
});

// Uruchamiamy obserwatora na całym ciele dokumentu
observer.observe(document.body, { childList: true, subtree: true });

// Ręczne uruchomienie dla elementów widocznych od razu po załadowaniu
setTimeout(() => {
    podmienWalutePrzezCSS();
}, 200); // Małe opóźnienie, by mieć pewność, że zmienna z walutą jest już zaczytana
