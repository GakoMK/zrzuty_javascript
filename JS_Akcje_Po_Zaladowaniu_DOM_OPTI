// 1. Bezpieczna funkcja podmieniająca węzły tekstowe
function bezpiecznaPodmianaWaluty() {
    let domyslnaWaluta = GetValue('#{FLD:2401}#') || "";
    if (!domyslnaWaluta) return; // Zabezpieczenie, jeśli pole waluty jest jeszcze puste

    let treeWalker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: function(node) {
            // Pomijamy węzły wewnątrz skryptów i stylów
            if (node.parentNode && (node.parentNode.nodeName === 'SCRIPT' || node.parentNode.nodeName === 'STYLE')) {
                return NodeFilter.FILTER_REJECT;
            }
            // Szukamy tylko węzłów z naszym placeholderem
            if (node.nodeValue.includes('[_waluta_]')) {
                return NodeFilter.FILTER_ACCEPT;
            }
            return NodeFilter.FILTER_SKIP;
        }
    }, false);

    let nodesToReplace = [];
    let currentNode;
    while (currentNode = treeWalker.nextNode()) {
        nodesToReplace.push(currentNode);
    }

    nodesToReplace.forEach(textNode => {
        if (textNode.parentNode) {
            let newText = textNode.nodeValue.replace(/\[_waluta_\]/g, domyslnaWaluta);
            
            // ROZWIĄZANIE BŁĘDU WEBCON:
            // Zamiast textNode.data = newText, tworzymy i podmieniamy cały węzeł
            let newTextNode = document.createTextNode(newText);
            textNode.parentNode.replaceChild(newTextNode, textNode);
        }
    });
}

// 2. Inicjalizacja nasłuchiwania na dynamiczne zmiany formularza
function inicjalizujDynamicznaPodmiane() {
    // Odpalamy pierwszy raz dla elementów, które już są na stronie
    bezpiecznaPodmianaWaluty();

    // Tworzymy obserwatora na wypadek, gdyby formularz doładował nowe pola
    const observer = new MutationObserver((mutations) => {
        let shouldUpdate = false;
        
        for (let mutation of mutations) {
            // Reagujemy tylko na dodawanie nowych węzłów do DOM
            if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                shouldUpdate = true;
                break;
            }
        }

        if (shouldUpdate) {
            // ZATRZYMUJEMY obserwator na czas naszej własnej modyfikacji,
            // aby nie wpaść w nieskończoną pętlę (nasze replaceChild też wyzwala childList)
            observer.disconnect();
            
            bezpiecznaPodmianaWaluty();
            
            // WZNAWIAMY nasłuchiwanie
            startObserving();
        }
    });

    function startObserving() {
        // Nasłuchujemy zmian na całym ciele dokumentu
        observer.observe(document.body, { childList: true, subtree: true });
    }

    startObserving();
}

// 3. Bonus: Ulepszona funkcja czyBilety (Event Delegation)
// Stara wersja przestałaby działać, jeśli pole checkbox pojawiłoby się dynamicznie
function czyBiletyDynamiczne() {
    document.body.addEventListener('click', function(e) {
        // Sprawdzamy czy to, w co kliknął użytkownik jest naszym checkboxem
        let target = e.target.closest("#AttBool2 .check-box__styled-input");
        if (target) {
            console.log('Kliknięto dynamiczny element biletu.');
            var biletySection = document.querySelector("#biletySection");
            if (biletySection) {
                biletySection.scrollIntoView({ behavior: 'smooth' });
            }
        }
    });
}


// ----------------------------- TECHNICZNE
const isElementLoaded = async selector => {
    while (document.querySelector(selector) === null) {
        await new Promise(resolve => requestAnimationFrame(resolve));
    }
    return document.querySelector(selector);
};

// Start całego skryptu
isElementLoaded('#BottomPanel').then(() => {
    console.log("Element załadowany – uruchamiam funkcje modyfikujące UI");
    inicjalizujDynamicznaPodmiane();
    czyBiletyDynamiczne();
});
