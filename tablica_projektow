}

.mk_task-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    font-size: 12px;
    color: var(--text-tertiary);
    text-decoration: none;
    font-weight: 600;
}

.mk_task-toggle i {
    font-size: 20px !important;
    text-decoration: none !important;
}

.mk_add-task {
    display: inline-flex;
    align-items: center;
    color: var(--text-tertiary);
    text-decoration: none !important;
    padding: 3px;
    padding-left: 8px;
}

.mk_add-task:hover {
    font-weight: 600;
}

.mk_add-task i {
    font-size: 20px !important;
    text-decoration: none !important;
}

.mk_task-section {
    align-items: center;
    display: inline;
    /* display: block !important; */
    width: 100%;
    padding: 6px 10px;
    gap: 12px;
}

.mk_task-toggle:hover {
    color: #981929 !important;
}

.mk_task-list {
    padding-top: 10px;
    display: block;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.3s ease;
}

.mk_task-list.active {
    max-height: 500px;
    opacity: 1;
}

.mk_task-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    font-size: 12px;
    color: var(--text-secondary);
