    --fluent-gray-100: #F3F2F1;
    --fluent-gray-200: #EDE7E2;
    --fluent-gray-300: #D9D4CF;
    --fluent-gray-400: #C5BEC6;
    --fluent-gray-500: #A38C9C;

    --bg-card: #ffffff;
    --text-primary: #1D2939;
    --text-secondary: #475569;
    --text-tertiary: #64748b;
    --border-color: #E2E8F0;
    --shadow-sm: 0 1px 2px rgba(0,0,0,.05);

