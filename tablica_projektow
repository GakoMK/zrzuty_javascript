}

#mk_knb_main_board .box,
#mk_knb_main_board .box--filled,
#mk_knb_main_board .box--no-padding,
#mk_knb_main_board .box--after-border {
  border: 1px solid transparent;
  background: transparent; /* lub np. inherit */
  box-shadow: none !important;
}

#mk_knb_main_board .dynamic-form .sql-grid-container {
  margin: 0px;
}

.top-bar-header { display: none; }

