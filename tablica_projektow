}

.mk_knb_column .upsidePanel__label { background-color: #ffffff; }
.mk_knb_column .stylePanel { padding: 0px; }

.mk_knb_column td[data-column="Projekt"] {
    padding: 0 !important;
    background: none !important;
}

.mk_knb_column td[data-column="Projekt"] > .grid-cell,
.mk_knb_column td[data-column="Projekt"] > .grid-cell > .textCell {
    padding: 0 !important;
    background: none !important;
}

tr, td, tbody {
    background: none !important;
    border: none !important;
    box-shadow: none !important;
}

.mk_knb_column table tr,
.mk_knb_column table td,
.mk_knb_column table tbody tr,
.mk_knb_column .grid-row,
.mk_knb_column .gridRow,
.mk_knb_column .data-row,
.mk_knb_column .dataRow,
.mk_knb_column [class*="row"],
.mk_knb_column [class*="Row"] {
