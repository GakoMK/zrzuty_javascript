    color: var(--fluent-blue);
}

.mk_task-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.webcon-ui.icon-ic_fluent,
.i-icon { font-size: 15px; }

.mk_chevron { transition: transform .2s ease; }
.mk_chevron.rotated { transform: rotate(180deg); }
</style>


<script>
window.WEBCON_Kanban = window.WEBCON_Kanban || {};

/* OTWIERANIE/ZAMYKANIE LIST ZADAŃ */
window.WEBCON_Kanban.toggleTasks = function(toggleElement) {
    const section = toggleElement.closest('.mk_task-section');
    if (!section) return;

    const taskList = section.querySelector('.mk_task-list');
    if (!taskList) return;

    taskList.classList.toggle('active');

    const chevron = toggleElement.querySelector('.mk_chevron');
    if (chevron) chevron.classList.toggle('rotated');

    const isOpen = taskList.classList.contains('active');
    const textNode =
        toggleElement.querySelector('.mk_task-toggle-text') ||
        toggleElement.querySelector('[data-role="toggle-text"]');

    if (textNode) {
        textNode.textContent = isOpen ? 'Ukryj zadania' : 'Pokaż zadania';
    }
};

/* ✅ KLUCZOWA FUNKCJA – RÓWNE SZEROKOŚCI KOLUMN */
function equalizeColumnWidths() {
    const board = document.getElementById("mk_knb_main_board");
    if (!board) return;

    const cols = board.querySelectorAll(".mk_knb_column");
    if (!cols.length) return;

    const boardWidth = board.clientWidth;
    const count = cols.length;

    const width = Math.floor(boardWidth / count);

    cols.forEach(col => {
        col.style.flex = "0 0 " + width + "px";
        col.style.maxWidth = width + "px";
        col.style.minWidth = width + "px";
    });
}

/* ✅ GENEROWANIE KOLUMN */
(function () {
    const container = document.getElementById("Group_5620children");
    if (!container) {
        console.warn("Nie znaleziono kontenera Group_5620children");
        return;
    }

    let row = document.getElementById("mk_knb_main_board");
    if (!row) {
        row = document.createElement("div");
        row.setAttribute("id", "mk_knb_main_board");
        row.classList.add("mk_knb_board");
        container.appendChild(row);
    }

    const gridIds = [
        "SEL_SQLGrid_5648",
        "SEL_SQLGrid_5636",
        "SEL_SQLGrid_5630",
        "SEL_SQLGrid_5642",
        "SEL_SQLGrid_5635"
    ];

    gridIds.forEach(id => {
        const grid = document.getElementById(id);
        if (grid && grid.parentNode) {
            const col = document.createElement("div");
            col.classList.add("mk_knb_column");
            col.appendChild(grid);
            row.appendChild(col);
        }
    });

    /* ✅ kluczowe – po wygenerowaniu kolumn */
    setTimeout(equalizeColumnWidths, 150);

    /* ✅ przeliczenie przy zmianie rozmiaru okna */
    window.addEventListener("resize", equalizeColumnWidths);

})();

</script>
