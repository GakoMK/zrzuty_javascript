}

.mk_knb_card-meta {
    display: flex;
    align-items: center;
    padding: 4px 10px;
    gap: 12px;
    border-bottom: 1px solid var(--border-color);
}

.mk_meta-item {
    display: flex;
    align-items: center;
    gap: 4px;
