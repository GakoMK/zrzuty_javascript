<script>
(function () {
  "use strict";

  // ==========================================
  // 1. ZMIENNE I STAN APLIKACJI
  // ==========================================
  var mk_mod_webconField = '#{FLD:5978}#';

  var mk_mod_path_colors = { 'default': '#9ca3af', 'green': '#10b981', 'blue': '#3b82f6', 'orange': '#f59e0b', 'purple': '#8b5cf6', 'red': '#ef4444' };

  var mk_mod_palette = [
    { type: "group", label: "Grupa / Panel", icon: "▣", hint: "Kontener na pola" },
    { type: "text", label: "Pole tekstowe", icon: "Aa", hint: "Krótki tekst" },
    { type: "textarea", label: "Pole wielowierszowe", icon: "¶", hint: "Dłuższy opis" },
    { type: "number", label: "Liczba", icon: "12", hint: "Wartość liczbowa" },
    { type: "date", label: "Data", icon: "◫", hint: "Data" },
    { type: "select", label: "Lista rozwijana", icon: "▾", hint: "Opcje wyboru" },
    { type: "checkbox", label: "Checkbox", icon: "☑", hint: "Wartość Tak / Nie" },
    { type: "person", label: "Osoba", icon: "", hint: "Wybór osoby" }
  ];

  var mk_mod_state = {
    selectedId: null,
    selectedKind: null,
    isLocked: false,
    isLeftPanelCollapsed: false,
    viewMode: "form",
    clipboardItems: null,
    dragNode: { active: false, stepId: null, startX: 0, startY: 0, initialX: 0, initialY: 0 },
    linkNode: { active: false, sourceId: null, startX: 0, startY: 0, currentX: 0, currentY: 0 },
    model: { version: "4.3", title: "Model formularza", steps: [] }
  };

  // ==========================================
  // 2. FUNKCJE POMOCNICZE
  // ==========================================
  function mk_mod_uid(prefix) { return "mk_mod_" + prefix + "_" + Math.random().toString(36).slice(2, 10); }
  
  function mk_mod_escapeHtml(value) {
    return String(value == null ? "" : value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }
  
  function mk_mod_clone(value) { return JSON.parse(JSON.stringify(value)); }
  
  function getArrowIntersection(x1, y1, x2, y2, w, h, isGateway) {
    var dx = x1 - x2; var dy = y1 - y2;
    var absDx = Math.abs(dx); var absDy = Math.abs(dy);
    if (absDx === 0 && absDy === 0) return {x: x2, y: y2};
    var targetW = isGateway ? w * 1.15 : w; var targetH = isGateway ? h * 1.15 : h;
    var scaleX = (targetW / 2 + 10) / absDx; var scaleY = (targetH / 2 + 10) / absDy;
    var scale = Math.min(scaleX, scaleY); if (scale > 1) scale = 1;
    return { x: x2 + dx * scale, y: y2 + dy * scale };
  }

  // ==========================================
  // 3. LOGIKA MODELU DANYCH
  // ==========================================
  function mk_mod_normalizeModel(raw) {
    if (!raw || typeof raw !== "object" || !Array.isArray(raw.steps)) return null;
    if (raw.steps.length === 0) {
        raw.steps.push({ id: mk_mod_uid("step"), name: "Krok Startowy", stepDescription: "", ui_x: 100, ui_y: 100, stepType: "start", items: [], paths: [] });
    }
    raw.steps.forEach(function (step, index) {
      if (!step.id) step.id = mk_mod_uid("step");
      step.name = step.name || "Nowy krok";
      step.stepDescription = step.stepDescription || "";
      step.ui_x = typeof step.ui_x === "number" ? step.ui_x : (index * 240 + 100);
      step.ui_y = typeof step.ui_y === "number" ? step.ui_y : 100;
      step.stepType = step.stepType || "intermediate";
      if (!Array.isArray(step.items)) step.items = [];
      if (!Array.isArray(step.paths)) step.paths = [];

      step.items.forEach(function(it) {
          if (!it.id) it.id = mk_mod_uid(it.kind || "item");
          if (it.kind === "group") {
             it.title = it.title || "Nowa grupa";
             if (!Array.isArray(it.items)) it.items = [];
          } else {
             it.kind = "field"; it.type = it.type || "text"; it.label = it.label || "nazwa atrybutu";
             it.required = !!it.required; it.placeholder = it.placeholder || ""; it.sampleValue = it.sampleValue || "";
             it.isVisible = it.isVisible !== false; // domyślnie true
             it.isEditable = it.isEditable !== false; // domyślnie true
             if (!Array.isArray(it.options)) it.options = [];
          }
      });
      step.paths = step.paths.map(function (path) {
        if (typeof path === "string") return { id: mk_mod_uid("path"), name: path, assignee: "", action: "", targetStepId: null, color: 'default' };
        return {
          id: path.id || mk_mod_uid("path"), name: path.name || "Nowa ścieżka", assignee: path.assignee || "",
          action: path.action || "", targetStepId: path.targetStepId || null, color: mk_mod_path_colors[path.color] ? path.color : 'default'
        };
      });
    });
    raw.version = raw.version || "4.3";
    raw.title = raw.title || "Model formularza";
    return raw;
  }

  function mk_mod_createDefaultField(type) {
    var field = { id: mk_mod_uid("field"), kind: "field", type: type, label: "nazwa atrybutu", required: false, placeholder: "", sampleValue: "", options: [], isVisible: true, isEditable: true };
    if (type === "select") { field.options = ["Opcja 1", "Opcja 2"]; field.sampleValue = "Opcja 1"; }
    if (type === "date") field.sampleValue = "2026-03-06";
    if (type === "checkbox") field.sampleValue = "true";
    if (type === "person") field.sampleValue = "Jan Kowalski";
    return field;
  }
  
  function mk_mod_createDefaultGroup() { return { id: mk_mod_uid("group"), kind: "group", title: "Nowa grupa", items: [] }; }

  function mk_mod_getWebconValue() { try { if (typeof GetValue === "function") return GetValue(mk_mod_webconField) || ""; } catch (e) {} return ""; }
  function mk_mod_setWebconValue(text) { try { if (typeof SetValue === "function") SetValue(mk_mod_webconField, text || ""); } catch (e) {} }

  function mk_mod_loadModelFromWebcon() {
    var raw = mk_mod_getWebconValue();
    if (!raw || !String(raw).trim()) { mk_mod_state.model = mk_mod_normalizeModel({ steps: [] }); return; }
    try {
      var parsed = JSON.parse(raw);
      var normalized = mk_mod_normalizeModel(parsed);
      if (normalized) {
        if (typeof parsed.isLocked === "boolean") mk_mod_state.isLocked = parsed.isLocked;
        if (typeof parsed.viewMode === "string") mk_mod_state.viewMode = parsed.viewMode;
        mk_mod_state.model = normalized;
      }
    } catch (error) { mk_mod_state.model = mk_mod_normalizeModel({ steps: [] }); }
  }

  function mk_mod_syncJson() {
    var payload = mk_mod_clone(mk_mod_state.model);
    payload.isLocked = mk_mod_state.isLocked;
    payload.viewMode = mk_mod_state.viewMode;
    mk_mod_setWebconValue(JSON.stringify(payload, null, 2));
  }

  function mk_mod_regenerateAllIdsForItem(item) {
    item.id = mk_mod_uid(item.kind || "item");
    if (item.kind === "group" && Array.isArray(item.items)) {
      item.items.forEach(function (child) { mk_mod_regenerateAllIdsForItem(child); });
    }
  }

  function mk_mod_findStepById(stepId) { return mk_mod_state.model.steps.find(function (step) { return step.id === stepId; }) || null; }
  function mk_mod_findItemById(id, items, stepId, parentGroupId) {
    items = items || [];
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      if (item.id === id) return { item: item, array: items, index: i, stepId: stepId || null, parentGroupId: parentGroupId || null };
      if (item.kind === "group" && Array.isArray(item.items)) {
        var nested = mk_mod_findItemById(id, item.items, stepId, item.id);
        if (nested) return nested;
      }
    }
    return null;
  }
  function mk_mod_findAnyItem(id) {
    for (var s = 0; s < mk_mod_state.model.steps.length; s++) {
      var found = mk_mod_findItemById(id, mk_mod_state.model.steps[s].items, mk_mod_state.model.steps[s].id, null);
      if (found) return found;
    }
    return null;
  }
  function mk_mod_findPathById(pathId) {
    for (var i = 0; i < mk_mod_state.model.steps.length; i++) {
      var step = mk_mod_state.model.steps[i];
      for (var j = 0; j < step.paths.length; j++) {
        if (step.paths[j].id === pathId) return { step: step, path: step.paths[j], index: j };
      }
    }
    return null;
  }
  function mk_mod_getTargetArray(stepId, containerId) {
    var step = mk_mod_findStepById(stepId);
    if (!step) return null;
    if (!containerId || containerId === "root") return step.items;
    var found = mk_mod_findItemById(containerId, step.items, step.id, null);
    if (found && found.item.kind === "group") return found.item.items;
    return null;
  }

