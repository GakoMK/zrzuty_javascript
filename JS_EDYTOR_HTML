<script>
(function () {
  "use strict";

  // ==========================================
  // 1. ZMIENNE I STAN APLIKACJI
  // ==========================================
  var mk_mod_webconField = '#{FLD:1243}#';

  var mk_mod_path_colors = { 
      'default': '#9ca3af', 'green': '#84cc16', 'blue': '#0ea5e9', 'red': '#ef4444' 
  };

  var mk_mod_palette = [
    { type: "group", label: "Grupa / Panel", icon: "▣", hint: "Kontener na pola" },
    { type: "text", label: "Pole tekstowe", icon: "Aa", hint: "Krótki tekst" },
    { type: "textarea", label: "Pole wielowierszowe", icon: "¶", hint: "Dłuższy opis" },
    { type: "number", label: "Liczba", icon: "12", hint: "Wartość liczbowa" },
    { type: "date", label: "Data", icon: "◫", hint: "Data" },
    { type: "select", label: "Lista rozwijana", icon: "▾", hint: "Opcje wyboru" },
    { type: "checkbox", label: "Checkbox", icon: "☑", hint: "Wartość Tak / Nie" },
    { type: "person", label: "Osoba", icon: "", hint: "Wybór osoby" }
  ];

  var mk_mod_state = {
    selectedId: null, selectedKind: null, isLocked: false, isLeftPanelCollapsed: false, viewMode: "form", clipboardItems: null,
    dragNode: { active: false, stepId: null, startX: 0, startY: 0, initialX: 0, initialY: 0 },
    linkNode: { active: false, sourceId: null, startX: 0, startY: 0, currentX: 0, currentY: 0 },
    model: { version: "4.3", title: "Model formularza", steps: [] }
  };

  // ==========================================
  // 2. FUNKCJE POMOCNICZE
  // ==========================================
  function mk_mod_uid(prefix) { return "mk_mod_" + prefix + "_" + Math.random().toString(36).slice(2, 10); }
  function mk_mod_escapeHtml(value) { return String(value == null ? "" : value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
  function mk_mod_clone(value) { return JSON.parse(JSON.stringify(value)); }

  // NOWY ALGORYTM ROUTINGU ORTOGONALNEGO
  function mk_mod_getOrthogonalPoints(rect1, rect2) {
      var c1 = {x: rect1.x + rect1.w/2, y: rect1.y + rect1.h/2};
      var c2 = {x: rect2.x + rect2.w/2, y: rect2.y + rect2.h/2};

      var dx = c2.x - c1.x;
      var dy = c2.y - c1.y;

      var p1, p2;
      var useVertical = Math.abs(dy) > Math.abs(dx) * 1.2;

      if (useVertical) {
          p1 = { x: c1.x, y: dy > 0 ? rect1.y + rect1.h : rect1.y, dir: dy > 0 ? 'D' : 'U' };
          p2 = { x: c2.x, y: dy > 0 ? rect2.y : rect2.y + rect2.h, dir: dy > 0 ? 'U' : 'D' };
      } else {
          p1 = { x: dx > 0 ? rect1.x + rect1.w : rect1.x, y: c1.y, dir: dx > 0 ? 'R' : 'L' };
          p2 = { x: dx > 0 ? rect2.x : rect2.x + rect2.w, y: c2.y, dir: dx > 0 ? 'L' : 'R' };
      }

      var points = [p1];
      var gap = 30; // Zasięg "łamania"

      if (p1.dir === 'R' && p2.dir === 'L') {
          if (p1.x + gap <= p2.x) {
              var midX = p1.x + (p2.x - p1.x)/2;
              points.push({x: midX, y: p1.y}); points.push({x: midX, y: p2.y});
          } else {
              var midY = (p1.y < p2.y) ? Math.max(rect1.y+rect1.h, rect2.y+rect2.h) + gap : Math.min(rect1.y, rect2.y) - gap;
              points.push({x: p1.x + gap, y: p1.y}); points.push({x: p1.x + gap, y: midY});
              points.push({x: p2.x - gap, y: midY}); points.push({x: p2.x - gap, y: p2.y});
          }
      }
      else if (p1.dir === 'L' && p2.dir === 'R') {
          if (p1.x - gap >= p2.x) {
              var midX = p2.x + (p1.x - p2.x)/2;
              points.push({x: midX, y: p1.y}); points.push({x: midX, y: p2.y});
          } else {
              var midY = (p1.y < p2.y) ? Math.max(rect1.y+rect1.h, rect2.y+rect2.h) + gap : Math.min(rect1.y, rect2.y) - gap;
              points.push({x: p1.x - gap, y: p1.y}); points.push({x: p1.x - gap, y: midY});
              points.push({x: p2.x + gap, y: midY}); points.push({x: p2.x + gap, y: p2.y});
          }
      }
      else if (p1.dir === 'D' && p2.dir === 'U') {
          if (p1.y + gap <= p2.y) {
              var midY = p1.y + (p2.y - p1.y)/2;
              points.push({x: p1.x, y: midY}); points.push({x: p2.x, y: midY});
          } else {
              var midX = (p1.x < p2.x) ? Math.max(rect1.x+rect1.w, rect2.x+rect2.w) + gap : Math.min(rect1.x, rect2.x) - gap;
              points.push({x: p1.x, y: p1.y + gap}); points.push({x: midX, y: p1.y + gap});
              points.push({x: midX, y: p2.y - gap}); points.push({x: p2.x, y: p2.y - gap});
          }
      }
      else if (p1.dir === 'U' && p2.dir === 'D') {
          if (p1.y - gap >= p2.y) {
              var midY = p2.y + (p1.y - p2.y)/2;
              points.push({x: p1.x, y: midY}); points.push({x: p2.x, y: midY});
          } else {
              var midX = (p1.x < p2.x) ? Math.max(rect1.x+rect1.w, rect2.x+rect2.w) + gap : Math.min(rect1.x, rect2.x) - gap;
              points.push({x: p1.x, y: p1.y - gap}); points.push({x: midX, y: p1.y - gap});
              points.push({x: midX, y: p2.y + gap}); points.push({x: p2.x, y: p2.y + gap});
          }
      }
      points.push(p2);
      return points;
  }

  function mk_mod_pointsToSvgPath(points, radius) {
      if (!points || points.length < 2) return "";
      var d = "M " + points[0].x + " " + points[0].y;

      for (var i = 1; i < points.length - 1; i++) {
          var p0 = points[i - 1], p1 = points[i], p2 = points[i + 1];
          var dx0 = p0.x - p1.x, dy0 = p0.y - p1.y, len0 = Math.sqrt(dx0*dx0 + dy0*dy0);
          var dx2 = p2.x - p1.x, dy2 = p2.y - p1.y, len2 = Math.sqrt(dx2*dx2 + dy2*dy2);
          var r = Math.min(radius, len0/2, len2/2);

          if (r > 0) {
              var startX = p1.x + (dx0 / len0) * r, startY = p1.y + (dy0 / len0) * r;
              var endX = p1.x + (dx2 / len2) * r, endY = p1.y + (dy2 / len2) * r;
              d += " L " + startX + " " + startY + " Q " + p1.x + " " + p1.y + " " + endX + " " + endY;
          } else {
              d += " L " + p1.x + " " + p1.y;
          }
      }
      d += " L " + points[points.length - 1].x + " " + points[points.length - 1].y;
      return d;
  }

  // ==========================================
  // 3. LOGIKA MODELU DANYCH
  // ==========================================
  function mk_mod_removeStep(stepId) {
      mk_mod_state.model.steps.forEach(function(step) { step.paths = step.paths.filter(function(path) { return path.targetStepId !== stepId; }); });
      mk_mod_state.model.steps = mk_mod_state.model.steps.filter(function(step) { return step.id !== stepId; });
      mk_mod_state.selectedId = null; mk_mod_state.selectedKind = null; mk_mod_syncJson();
  }
  function mk_mod_removeSelectedPath() {
      var pathId = mk_mod_state.selectedId;
      mk_mod_state.model.steps.forEach(function(step) { step.paths = step.paths.filter(function(path) { return path.id !== pathId; }); });
      mk_mod_state.selectedId = null; mk_mod_state.selectedKind = null; mk_mod_syncJson();
  }
  function mk_mod_normalizeModel(raw) {
    if (!raw || typeof raw !== "object" || !Array.isArray(raw.steps)) return null;
    if (raw.steps.length === 0) raw.steps.push({ id: mk_mod_uid("step"), name: "Krok Startowy", stepDescription: "", ui_x: 100, ui_y: 100, stepType: "start", items: [], paths: [] });
    raw.steps.forEach(function (step, index) {
      if (!step.id) step.id = mk_mod_uid("step");
      step.name = step.name || "Nowy krok"; step.stepDescription = step.stepDescription || "";
      step.ui_x = typeof step.ui_x === "number" ? step.ui_x : (index * 240 + 100); step.ui_y = typeof step.ui_y === "number" ? step.ui_y : 100;
      step.stepType = step.stepType || "intermediate"; if (!Array.isArray(step.items)) step.items = []; if (!Array.isArray(step.paths)) step.paths = [];
      step.items.forEach(function(it) {
          if (!it.id) it.id = mk_mod_uid(it.kind || "item");
          if (it.kind === "group") { it.title = it.title || "Nowa grupa"; if (!Array.isArray(it.items)) it.items = []; } 
          else { 
             it.kind = "field"; it.type = it.type || "text"; 
             // POPRAWKA: Utrzymanie ewentualnej, już wpisanej pustej nazwy (nie nadpisujemy domyślnie "nazwa atrybutu")
             it.label = it.label !== undefined ? it.label : ""; 
             it.isVisible = it.isVisible !== false; it.isEditable = it.isEditable !== false; 
          }
      });
      step.paths = step.paths.map(function (path) {
        if (typeof path === "string") return { id: mk_mod_uid("path"), name: path, assignee: "", action: "", targetStepId: null, color: 'default' };
        return { id: path.id || mk_mod_uid("path"), name: path.name || "Nowa ścieżka", action: path.action || "", targetStepId: path.targetStepId || null, color: mk_mod_path_colors[path.color] ? path.color : 'default' };
      });
    });
    raw.version = raw.version || "4.3"; return raw;
  }
  
  function mk_mod_createDefaultField(type) { 
      // POPRAWKA: Tworząc nowe pole ma ono domyślnie pusty label ("") zamiast "nazwa atrybutu"
      var field = { id: mk_mod_uid("field"), kind: "field", type: type, label: "", required: false, placeholder: "", sampleValue: "", options: [], isVisible: true, isEditable: true }; 
      if (type === "select") { field.options = ["Opcja 1", "Opcja 2"]; field.sampleValue = "Opcja 1"; } 
      return field; 
  }
  
  function mk_mod_createDefaultGroup() { return { id: mk_mod_uid("group"), kind: "group", title: "Nowa grupa", items: [] }; }
  function mk_mod_getWebconValue() { try { if (typeof GetValue === "function") return GetValue(mk_mod_webconField) || ""; } catch (e) {} return ""; }
  function mk_mod_setWebconValue(text) { try { if (typeof SetValue === "function") SetValue(mk_mod_webconField, text || ""); } catch (e) {} }
  function mk_mod_loadModelFromWebcon() { var raw = mk_mod_getWebconValue(); if (!raw || !String(raw).trim()) { mk_mod_state.model = mk_mod_normalizeModel({ steps: [] }); return; } try { var parsed = JSON.parse(raw); var normalized = mk_mod_normalizeModel(parsed); if (normalized) { if (typeof parsed.viewMode === "string") mk_mod_state.viewMode = parsed.viewMode; mk_mod_state.model = normalized; } } catch (error) { mk_mod_state.model = mk_mod_normalizeModel({ steps: [] }); } }
  function mk_mod_syncJson() { var payload = mk_mod_clone(mk_mod_state.model); payload.viewMode = mk_mod_state.viewMode; mk_mod_setWebconValue(JSON.stringify(payload, null, 2)); }
  function mk_mod_regenerateAllIdsForItem(item) { item.id = mk_mod_uid(item.kind || "item"); if (item.kind === "group" && Array.isArray(item.items)) { item.items.forEach(function (child) { mk_mod_regenerateAllIdsForItem(child); }); } }
  function mk_mod_findStepById(stepId) { return mk_mod_state.model.steps.find(function (step) { return step.id === stepId; }) || null; }
  function mk_mod_findItemById(id, items, stepId, parentGroupId) { items = items || []; for (var i = 0; i < items.length; i++) { var item = items[i]; if (item.id === id) return { item: item, array: items, index: i, stepId: stepId || null, parentGroupId: parentGroupId || null }; if (item.kind === "group" && Array.isArray(item.items)) { var nested = mk_mod_findItemById(id, item.items, stepId, item.id); if (nested) return nested; } } return null; }
  function mk_mod_findAnyItem(id) { for (var s = 0; s < mk_mod_state.model.steps.length; s++) { var found = mk_mod_findItemById(id, mk_mod_state.model.steps[s].items, mk_mod_state.model.steps[s].id, null); if (found) return found; } return null; }
  function mk_mod_findPathById(pathId) { for (var i = 0; i < mk_mod_state.model.steps.length; i++) { var step = mk_mod_state.model.steps[i]; for (var j = 0; j < step.paths.length; j++) { if (step.paths[j].id === pathId) return { step: step, path: step.paths[j], index: j }; } } return null; }
  function mk_mod_getTargetArray(stepId, containerId) { var step = mk_mod_findStepById(stepId); if (!step) return null; if (!containerId || containerId === "root") return step.items; var found = mk_mod_findItemById(containerId, step.items, step.id, null); if (found && found.item.kind === "group") return found.item.items; return null; }

  // ==========================================
  // 4. RENDEROWANIE FLOW Z NOWYMI ŚCIEŻKAMI
  // ==========================================
  function mk_mod_renderFlowPaths() {
    var svg = document.getElementById("mk_mod_flow_svg");
    var overlays = document.getElementById("mk_mod_flow_overlays");
    if (!svg || !overlays) return;
    
    var html = '<defs>';
    Object.keys(mk_mod_path_colors).forEach(function(key) {
        html += '<marker id="mk_mod_arrow_' + key + '" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="' + mk_mod_path_colors[key] + '" /></marker>';
    });
    html += '</defs>';
    var overlaysHtml = '';

    mk_mod_state.model.steps.forEach(function(step) {
      var el1 = document.querySelector('[data-mk-mod-flow-step="' + step.id + '"]');
      if (!el1) return;
      var rect1 = { x: step.ui_x, y: step.ui_y, w: el1.offsetWidth, h: el1.offsetHeight };

      step.paths.forEach(function(path) {
        if (!path.targetStepId) return;
        var targetStep = mk_mod_findStepById(path.targetStepId); if (!targetStep) return;
        var el2 = document.querySelector('[data-mk-mod-flow-step="' + targetStep.id + '"]'); if (!el2) return;

        var rect2 = { x: targetStep.ui_x, y: targetStep.ui_y, w: el2.offsetWidth, h: el2.offsetHeight };
        
        var points = mk_mod_getOrthogonalPoints(rect1, rect2);
        var pathD = mk_mod_pointsToSvgPath(points, 12); 

        var isSelected = mk_mod_state.selectedKind === "path" && mk_mod_state.selectedId === path.id;
        var strokeColor = mk_mod_path_colors[path.color] || mk_mod_path_colors['default'];
        var className = isSelected ? "mk_mod_flow_path mk_mod_flow_path_selected" : "mk_mod_flow_path";

        html += '<circle cx="' + points[0].x + '" cy="' + points[0].y + '" r="3" class="mk_mod_flow_port_dot" stroke="' + strokeColor + '" />';
        html += '<path class="' + className + '" d="' + pathD + '" stroke="' + strokeColor + '" marker-end="url(#mk_mod_arrow_' + path.color + ')" />';
        html += '<circle cx="' + points[points.length-1].x + '" cy="' + points[points.length-1].y + '" r="3" class="mk_mod_flow_port_dot" stroke="' + strokeColor + '" />';
        
        var p0 = points[0], p1 = points[1] || points[0];
        var lblX = (p0.x + p1.x) / 2;
        var lblY = (p0.y + p1.y) / 2;
        if (p0.y === p1.y) lblY -= 14; else lblX += 14;

        var selClass = isSelected ? ' mk_mod_selected' : '';
        overlaysHtml += '<div class="mk_mod_flow_path_overlay' + selClass + '" style="left:' + lblX + 'px; top:' + lblY + 'px;" onclick="window.mk_mod_api.selectPath(event, \'' + path.id + '\')"><span id="mk_mod_path_lbl_' + path.id + '">' + mk_mod_escapeHtml(path.name) + '</span></div>';
      });
    });

    if (mk_mod_state.linkNode.active) {
       html += '<line x1="' + mk_mod_state.linkNode.startX + '" y1="' + mk_mod_state.linkNode.startY + '" x2="' + mk_mod_state.linkNode.currentX + '" y2="' + mk_mod_state.linkNode.currentY + '" stroke="#9ca3af" stroke-width="3" stroke-dasharray="6" marker-end="url(#mk_mod_arrow_default)" />';
    }

    svg.innerHTML = html;
    overlays.innerHTML = overlaysHtml;
  }

  function mk_mod_renderFlowPanel() {
      var panel = document.getElementById("mk_mod_flow_properties_container");
      var title = document.getElementById("mk_mod_flow_panel_title");
      var body = document.getElementById("mk_mod_flow_panel_body");
      if (!panel || !body) return;

      if (!mk_mod_state.selectedKind || mk_mod_state.selectedKind === 'item') { panel.classList.remove('mk_mod_open'); return; }
      
      panel.classList.add('mk_mod_open');
      var html = '';

      if (mk_mod_state.selectedKind === 'step') {
          var step = mk_mod_findStepById(mk_mod_state.selectedId); if(!step) return;
          if(title) title.innerHTML = '<i class="webcon-ui icon-ic_fluent icon-ic_fluent_settings_20_regular icon-ic_fluent__size--20"></i> Właściwości Kroku';
          html += '<div class="mk_mod_form_row"><label>Nazwa kroku</label><input type="text" class="mk_mod_input" id="mk_mod_live_name" oninput="window.mk_mod_api.liveUpdate(this.id, this.value)" value="' + mk_mod_escapeHtml(step.name) + '"></div>';
          html += '<div style="margin-top:24px;"><button type="button" class="mk_mod_btn mk_btn_border" style="width:100%; color: var(--mk_mod_accent);" onclick="window.mk_mod_api.deleteLive(this)"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_delete_20_regular icon-ic_fluent__size--20"></i> Usuń krok</button></div>';
      } 
      else if (mk_mod_state.selectedKind === 'path') {
          var pathData = mk_mod_findPathById(mk_mod_state.selectedId); if(!pathData) return;
          if(title) title.innerHTML = '<i class="webcon-ui icon-ic_fluent icon-ic_fluent_branch_20_regular icon-ic_fluent__size--20"></i> Właściwości Ścieżki';
          
          var colorOptions = Object.keys(mk_mod_path_colors).map(function(c) {
              return '<option value="' + c + '" ' + (pathData.path.color===c?'selected':'') + '>' + c.charAt(0).toUpperCase() + c.slice(1) + '</option>';
          }).join('');

          html += '<div class="mk_mod_form_row"><label>Etykieta ścieżki (warunek)</label><input type="text" class="mk_mod_input" id="mk_mod_live_name" oninput="window.mk_mod_api.liveUpdate(this.id, this.value)" value="' + mk_mod_escapeHtml(pathData.path.name) + '"></div>';
          html += '<div class="mk_mod_form_row"><label>Kolor ścieżki</label><select class="mk_mod_select" id="mk_mod_live_color" onchange="window.mk_mod_api.liveUpdate(this.id, this.value)">' + colorOptions + '</select></div>';
          html += '<div style="margin-top:24px;"><button type="button" class="mk_mod_btn mk_btn_border" style="width:100%; color: var(--mk_mod_accent);" onclick="window.mk_mod_api.deleteLive(this)"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_delete_20_regular icon-ic_fluent__size--20"></i> Usuń połączenie</button></div>';
      }
      body.innerHTML = html;
  }

  function mk_mod_renderFlow() {
    var workspace = document.getElementById("mk_mod_flow_workspace_inner");
    if (!workspace) return;

    var toolbarHtml = mk_mod_state.isLocked ? '' : ''
      + '<div class="mk_mod_flow_toolbar">'
      +   '<button class="mk_mod_flow_toolbar_btn" title="Krok Startowy" onclick="window.mk_mod_api.addFlow(\'start\')" style="color: #facc15;"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_play_20_filled icon-ic_fluent__size--20"></i></button>'
      +   '<button class="mk_mod_flow_toolbar_btn" title="Krok Pośredni" onclick="window.mk_mod_api.addFlow(\'intermediate\')" style="color: #94a3b8;"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_more_horizontal_20_regular icon-ic_fluent__size--20"></i></button>'
      +   '<button class="mk_mod_flow_toolbar_btn" title="Bramka Decyzyjna" onclick="window.mk_mod_api.addFlow(\'gateway\')" style="color: #94a3b8;"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_diamond_20_regular icon-ic_fluent__size--20"></i></button>'
      +   '<button class="mk_mod_flow_toolbar_btn" title="Zakończenie Sukces" onclick="window.mk_mod_api.addFlow(\'end_success\')" style="color: #22c55e;"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_stop_20_filled icon-ic_fluent__size--20"></i></button>'
      +   '<button class="mk_mod_flow_toolbar_btn" title="Zakończenie Błąd" onclick="window.mk_mod_api.addFlow(\'end_negative\')" style="color: #ef4444;"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_warning_20_regular icon-ic_fluent__size--20"></i></button>'
      + '</div>';

    var html = toolbarHtml + '<svg id="mk_mod_flow_svg" class="mk_mod_flow_svg"></svg><div id="mk_mod_flow_overlays" class="mk_mod_flow_svg"></div>';
    
    mk_mod_state.model.steps.forEach(function(step) {
      var isSelected = mk_mod_state.selectedKind === "step" && mk_mod_state.selectedId === step.id ? " mk_mod_flow_node_selected" : "";
      var cssClass = "mk_mod_flow_node mk_mod_flow_node_" + mk_mod_escapeHtml(step.stepType) + isSelected;
      
      var iconClass = "icon-ic_fluent_more_horizontal_20_regular";
      if(step.stepType === 'start') iconClass = "icon-ic_fluent_play_20_filled";
      if(step.stepType === 'end_success') iconClass = "icon-ic_fluent_stop_20_filled";
      if(step.stepType === 'end_negative') iconClass = "icon-ic_fluent_warning_20_regular";

      var portHtml = mk_mod_state.isLocked ? '' : '<div class="mk_mod_flow_port" onmousedown="window.mk_mod_api.flowPortMouseDown(event, \'' + mk_mod_escapeHtml(step.id) + '\')" title="Pociągnij aby połączyć"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_arrow_routing_20_regular"></i></div>';

      html += '<div class="' + cssClass + '" style="left:' + step.ui_x + 'px; top:' + step.ui_y + 'px;" data-mk-mod-flow-step="' + mk_mod_escapeHtml(step.id) + '" onmousedown="window.mk_mod_api.flowNodeMouseDown(event, \'' + mk_mod_escapeHtml(step.id) + '\')">'
            +   '<div class="mk_mod_flow_node_icon"><i class="webcon-ui icon-ic_fluent ' + iconClass + ' icon-ic_fluent__size--20"></i></div>'
            +   '<div class="mk_mod_flow_node_content">'
            +     '<div class="mk_mod_flow_node_title" id="mk_mod_node_lbl_' + step.id + '">' + mk_mod_escapeHtml(step.name) + '</div>'
            +   '</div>'
            +   portHtml
            + '</div>';
    });

    workspace.innerHTML = html;
    mk_mod_renderFlowPaths();
    mk_mod_renderFlowPanel();
  }

  // ==========================================
  // RENDEROWANIE FORMULARZA I GŁÓWNA STRUKTURA
  // ==========================================
  
  function mk_mod_renderPalette() {
    return mk_mod_palette.map(function (item) {
      var extraClass = mk_mod_state.isLocked ? " mk_mod_disabled" : "";
      return '<div class="mk_mod_palette_item' + extraClass + '" ' + (mk_mod_state.isLocked ? '' : 'draggable="true" ondragstart="window.mk_mod_api.dragStartPalette(event, \'' + item.type + '\')"') + '><div class="mk_mod_icon_label"><span class="mk_mod_icon">' + mk_mod_escapeHtml(item.icon) + '</span><span>' + mk_mod_escapeHtml(item.label) + '</span></div><small>' + mk_mod_escapeHtml(item.hint) + '</small></div>';
    }).join("");
  }

  function mk_mod_renderLeftCellContent() {
    var collapsedClass = mk_mod_state.isLeftPanelCollapsed ? ' mk_mod_left_col_hidden' : '';
    var toggleIcon = mk_mod_state.isLeftPanelCollapsed ? '»' : '«';
    var libraryHtml = mk_mod_state.isLocked ? '<div class="mk_mod_note">Biblioteka ukryta w trybie podglądu.</div>' : '<div class="mk_mod_palette_grid">' + mk_mod_renderPalette() + '</div>';
    return '<div class="mk_mod_left_col_shell' + collapsedClass + '"><button type="button" class="mk_mod_left_col_toggle" onclick="window.mk_mod_api.toggleLeftPanel()">' + toggleIcon + '</button><div class="mk_mod_left_col_inner">' + libraryHtml + '</div><div class="mk_mod_collapsed_stub"><div class="mk_mod_collapsed_stub_text">Narzędzia</div></div></div>';
  }

  function mk_mod_renderFieldPreview(item, parentGroupId) {
    // POPRAWKA: Jeśli `item.label` jest puste (""), wyświetl elegancki szary napis [Brak nazwy] aby podgląd nie zniknął.
    var labelHtml = item.label ? mk_mod_escapeHtml(item.label) : '<span style="color:#9ca3af; font-style:italic;">[Brak nazwy]</span>';
    var value = item.sampleValue || "";
    var placeholder = item.placeholder || "";
    var requiredMark = item.required ? ' <span style="color:#991829">*</span>' : '';
    var hiddenBadge = !item.isVisible ? '<span class="mk_mod_badge_hidden" title="Pole ukryte"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_eye_off_20_regular"></i> Ukryte</span>' : '';
    var readonlyBadge = (!item.isEditable && item.isVisible) ? '<span class="mk_mod_badge_readonly" title="Tylko do odczytu"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_lock_20_regular"></i> Tylko odczyt</span>' : '';

    var extractBtn = (parentGroupId && !mk_mod_state.isLocked) ? '<button type="button" class="mk_mod_icon_btn" onclick="window.mk_mod_api.extractItem(event, \'' + item.id + '\')"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_arrow_up_left_20_regular"></i></button>' : '';
    var removeBtn = mk_mod_state.isLocked ? '' : '<button type="button" class="mk_mod_icon_btn" onclick="window.mk_mod_api.removeItem(event, \'' + item.id + '\')"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_delete_20_regular"></i></button>';
    var actionsHtml = '<div class="mk_mod_field_actions">' + extractBtn + removeBtn + '</div>';

    var fullLabel = labelHtml + requiredMark + hiddenBadge + readonlyBadge;

    if (item.type === "textarea") return '<div class="mk_mod_field_line"><div class="mk_mod_field_label">' + fullLabel + '</div><textarea class="mk_mod_preview_textarea" placeholder="' + mk_mod_escapeHtml(placeholder) + '" readonly>' + mk_mod_escapeHtml(value) + '</textarea>' + actionsHtml + '</div>';
    if (item.type === "number") return '<div class="mk_mod_field_line"><div class="mk_mod_field_label">' + fullLabel + '</div><input class="mk_mod_preview_input" type="number" value="' + mk_mod_escapeHtml(value) + '" placeholder="' + mk_mod_escapeHtml(placeholder) + '" readonly />' + actionsHtml + '</div>';
    if (item.type === "date") return '<div class="mk_mod_field_line"><div class="mk_mod_field_label">' + fullLabel + '</div><input class="mk_mod_preview_input" type="date" value="' + mk_mod_escapeHtml(value) + '" readonly />' + actionsHtml + '</div>';
    if (item.type === "select") {
      var options = (item.options && item.options.length ? item.options : ["Opcja 1"]).map(function (opt) { return '<option>' + mk_mod_escapeHtml(opt) + '</option>'; }).join("");
      return '<div class="mk_mod_field_line"><div class="mk_mod_field_label">' + fullLabel + '</div><select class="mk_mod_preview_select" disabled>' + options + '</select>' + actionsHtml + '</div>';
    }
    if (item.type === "checkbox") return '<div class="mk_mod_field_line"><div class="mk_mod_field_label">' + fullLabel + '</div><label class="mk_mod_preview_checkbox"><input type="checkbox" disabled /></label>' + actionsHtml + '</div>';
    return '<div class="mk_mod_field_line"><div class="mk_mod_field_label">' + fullLabel + '</div><input class="mk_mod_preview_input" type="text" value="' + mk_mod_escapeHtml(value) + '" placeholder="' + mk_mod_escapeHtml(placeholder) + '" readonly />' + actionsHtml + '</div>';
  }

  function mk_mod_renderItem(item, parentGroupId) {
    var isSelected = (mk_mod_state.selectedKind === "item" && mk_mod_state.selectedId === item.id);
    var isLocked = mk_mod_state.isLocked;
    
    var dragAttr = (isLocked || isSelected) ? "" : ' draggable="true" ondragstart="window.mk_mod_api.dragStartMove(event, \'' + item.id + '\')"';
    var clickAttr = ' onclick="window.mk_mod_api.selectItem(event, \'' + item.id + '\')"';
    
    var inlineEditorHtml = "";
    if (isSelected && !isLocked) {
        if (item.kind === "group") {
            inlineEditorHtml = '<div class="mk_mod_inline_editor mk_mod_inline_editor_group" onclick="event.stopPropagation()">' +
                '<div class="mk_mod_form_row"><label>Nazwa grupy</label><input class="mk_mod_input" id="mk_mod_prop_group_title" placeholder="Wpisz nazwę grupy..." value="' + mk_mod_escapeHtml(item.title || "") + '" /></div>' +
                '<div style="display:flex; gap:8px; margin-top:8px;"><button type="button" class="mk_mod_btn mk_mod_btn_primary mk_btn_border" onclick="window.mk_mod_api.saveProps(event)"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_save_20_regular icon-ic_fluent__size--20"></i> Zapisz</button><button type="button" class="mk_mod_btn mk_btn_border" onclick="window.mk_mod_api.deselectItem(event)">Zamknij</button></div>' +
                '</div>';
        } else {
            inlineEditorHtml = '<div class="mk_mod_inline_editor" onclick="event.stopPropagation()">' +
                '<div class="mk_mod_form_row"><label>Nazwa atrybutu</label><input class="mk_mod_input" id="mk_mod_prop_field_label" placeholder="Wpisz nazwę..." value="' + mk_mod_escapeHtml(item.label || "") + '" /></div>' +
                '<div class="mk_mod_form_row"><label>Opis działania (placeholder)</label><textarea class="mk_mod_textarea" id="mk_mod_prop_field_description" placeholder="Opcjonalny tekst pomocniczy..." style="min-height:50px;">' + mk_mod_escapeHtml(item.placeholder || "") + '</textarea></div>' +
                '<div class="mk_mod_inline_checkbox_group">' +
                    '<label><input type="checkbox" id="mk_mod_prop_field_required" ' + (item.required ? "checked" : "") + ' /> Pole wymagane</label>' +
                    '<label><input type="checkbox" id="mk_mod_prop_field_visible" ' + (item.isVisible ? "checked" : "") + ' /> Widoczne na kroku</label>' +
                    '<label><input type="checkbox" id="mk_mod_prop_field_editable" ' + (item.isEditable ? "checked" : "") + ' /> Edytowalne</label>' +
                '</div>' +
                '<div style="display:flex; gap:8px; margin-top:12px;"><button type="button" class="mk_mod_btn mk_mod_btn_primary mk_btn_border" onclick="window.mk_mod_api.saveProps(event)"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_save_20_regular icon-ic_fluent__size--20"></i> Zapisz</button><button type="button" class="mk_mod_btn mk_btn_border" onclick="window.mk_mod_api.deselectItem(event)">Zamknij</button></div>' +
                '</div>';
        }
    }
    
    if (item.kind === "group") {
      var parentInfo = mk_mod_findAnyItem(item.id);
      var currentStepId = parentInfo ? parentInfo.stepId : "";
      var innerHtml = "";

      if (!item.items.length) {
        innerHtml = (!isLocked ? '<div class="mk_mod_dropzone" ondragover="window.mk_mod_api.dragOver(event)" ondragleave="window.mk_mod_api.dragLeave(event)" ondrop="window.mk_mod_api.drop(event, \'' + currentStepId + '\', \'' + item.id + '\', 0)"></div>' : '')
          + '<div class="mk_mod_step_empty">Upuść tutaj pole (nie grupę).</div>';
      } else {
        innerHtml = item.items.map(function (child, idx) {
          return (!isLocked ? '<div class="mk_mod_dropzone" ondragover="window.mk_mod_api.dragOver(event)" ondragleave="window.mk_mod_api.dragLeave(event)" ondrop="window.mk_mod_api.drop(event, \'' + currentStepId + '\', \'' + item.id + '\', ' + idx + ')"></div>' : '')
            + mk_mod_renderItem(child, item.id);
        }).join("");
        if (!isLocked) {
          innerHtml += '<div class="mk_mod_dropzone" ondragover="window.mk_mod_api.dragOver(event)" ondragleave="window.mk_mod_api.dragLeave(event)" ondrop="window.mk_mod_api.drop(event, \'' + currentStepId + '\', \'' + item.id + '\', ' + item.items.length + ')"></div>';
        }
      }

      var extractGroupBtn = (parentGroupId && !isLocked) ? '<button type="button" class="mk_mod_icon_btn" title="Wyciągnij Grupę" onclick="window.mk_mod_api.extractItem(event, \'' + item.id + '\')"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_arrow_up_left_20_regular"></i></button>' : '';
      var removeGroupBtn = isLocked ? '' : '<button type="button" class="mk_mod_icon_btn" title="Usuń kontener" onclick="window.mk_mod_api.removeItem(event, \'' + item.id + '\')"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_delete_20_regular"></i></button>';

      return '<div class="mk_mod_group_box' + (isSelected ? ' mk_mod_selected' : '') + '"' + dragAttr + clickAttr + '><div class="mk_mod_group_title"><span>' + mk_mod_escapeHtml(item.title || "Nowa grupa") + '</span><div style="display: flex; gap: 4px;">' + extractGroupBtn + removeGroupBtn + '</div></div>' + inlineEditorHtml + '<div class="mk_mod_group_inner">' + innerHtml + '</div></div>';
    }

    var hiddenClass = !item.isVisible ? " mk_mod_field_hidden" : "";
    var readonlyClass = !item.isEditable ? " mk_mod_field_readonly" : "";

    return '<div class="mk_mod_field_box' + (isSelected ? ' mk_mod_selected' : '') + hiddenClass + readonlyClass + '"' + dragAttr + clickAttr + '>' + mk_mod_renderFieldPreview(item, parentGroupId) + inlineEditorHtml + '</div>';
  }

  function mk_mod_render() {
    var mk_mod_root = document.getElementById("mk_mod_app");
    if (!mk_mod_root) return;

    var leftCollapsedClass = mk_mod_state.isLeftPanelCollapsed ? ' mk_mod_left_collapsed' : '';
    
    var stepsHead = mk_mod_state.model.steps.map(function (step, index) {
      var copyPasteHtml = '';
      if (!mk_mod_state.isLocked) {
          copyPasteHtml += '<button type="button" class="mk_mod_icon_btn mk_mod_small_btn" title="Kopiuj atrybuty z tego kroku" onclick="window.mk_mod_api.copyStepItems(\'' + step.id + '\')"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_copy_20_regular icon-ic_fluent__size--20"></i></button>';
          if (mk_mod_state.clipboardItems) {
              copyPasteHtml += '<button type="button" class="mk_mod_icon_btn mk_mod_small_btn" title="Wklej skopiowane atrybuty" onclick="window.mk_mod_api.pasteStepItems(\'' + step.id + '\')"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_clipboard_paste_20_regular icon-ic_fluent__size--20"></i></button>';
          }
      }
      return '<th class="mk_mod_step_cell"><div class="mk_mod_step_head"><div class="mk_mod_step_head_top"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_steps_20_regular"></i> Krok ' + (index + 1) + '</div><div class="mk_mod_step_head_name">' + mk_mod_escapeHtml(step.name || "Nowy krok") + '</div>' + (!mk_mod_state.isLocked ? '<div class="mk_mod_step_head_actions">' + copyPasteHtml + '</div>' : '<div class="mk_mod_lock_badge">Tryb podglądu</div>') + '</div></th>';
    }).join("");

    var stepsBody = mk_mod_state.model.steps.map(function (step) {
      var html = "";
      if (!step.items.length) {
          html = (!mk_mod_state.isLocked ? '<div class="mk_mod_dropzone" ondragover="window.mk_mod_api.dragOver(event)" ondragleave="window.mk_mod_api.dragLeave(event)" ondrop="window.mk_mod_api.drop(event, \'' + step.id + '\', \'root\', 0)"></div>' : '') + '<div class="mk_mod_step_empty">Brak atrybutów w tym kroku. Użyj Drag&Drop, by przenieść pole z biblioteki.</div>';
      } else {
          step.items.forEach(function (item, index) {
              if (!mk_mod_state.isLocked) { html += '<div class="mk_mod_dropzone" ondragover="window.mk_mod_api.dragOver(event)" ondragleave="window.mk_mod_api.dragLeave(event)" ondrop="window.mk_mod_api.drop(event, \'' + step.id + '\', \'root\', ' + index + ')"></div>'; }
              html += mk_mod_renderItem(item, null);
          });
          if (!mk_mod_state.isLocked) { html += '<div class="mk_mod_dropzone" ondragover="window.mk_mod_api.dragOver(event)" ondragleave="window.mk_mod_api.dragLeave(event)" ondrop="window.mk_mod_api.drop(event, \'' + step.id + '\', \'root\', ' + step.items.length + ')"></div>'; }
      }
      return '<td class="mk_mod_step_cell"><div class="mk_mod_cell_body">' + html + '</div></td>';
    }).join("");

    mk_mod_root.innerHTML = ''
      + '<div class="mk_mod_app">'
      +   '<div class="mk_mod_header">'
      +     '<div class="mk_mod_title_box">'
      +       '<p>' + (mk_mod_state.isLocked ? 'Tryb podglądu formularza.' : 'Graficzne modelowanie przepływu (Flow) oraz formularza.') + '</p>'
      +     '</div>'
      +     '<div class="mk_mod_actions">'
      +       (!mk_mod_state.isLocked ? '<button type="button" class="mk_mod_btn mk_btn_border" onclick="window.mk_mod_api.clearEditor()" style="color:var(--mk_mod_accent);"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_delete_20_regular icon-ic_fluent__size--20"></i> Wyczyść edytor</button>' : '')
      +       '<button type="button" class="mk_mod_btn mk_btn_border" onclick="window.mk_mod_api.toggleView()"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_arrow_swap_20_regular icon-ic_fluent__size--20"></i> Zmień widok (Flow / Formularz)</button>'
      +       '<button type="button" class="mk_mod_btn mk_btn_border" onclick="window.mk_mod_api.toggleFullscreen()"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_full_screen_maximize_20_regular icon-ic_fluent__size--20"></i> Pełny ekran</button>'
      +       '<button type="button" class="mk_mod_btn mk_btn_border ' + (mk_mod_state.isLocked ? '' : 'mk_mod_btn_primary') + '" onclick="window.mk_mod_api.toggleLock()">' + (mk_mod_state.isLocked ? '<i class="webcon-ui icon-ic_fluent icon-ic_fluent_lock_open_20_regular icon-ic_fluent__size--20"></i> Odblokuj edycję' : '<i class="webcon-ui icon-ic_fluent icon-ic_fluent_lock_closed_20_regular icon-ic_fluent__size--20"></i> Zablokuj edycję') + '</button>'
      +     '</div>'
      +   '</div>'
      +   '<div class="mk_mod_card">'
      +     '<div class="mk_mod_card_body">'
      
      +       '<div id="mk_mod_form_view" class="' + (mk_mod_state.viewMode === "form" ? "" : "mk_mod_view_hidden") + '">'
      +         '<div class="mk_mod_board_wrap">'
      +           '<table class="mk_mod_board_table' + leftCollapsedClass + '">'
      +             '<colgroup>'
      +               '<col class="mk_mod_left_col_group">'
      +               mk_mod_state.model.steps.map(function () { return '<col class="mk_mod_step_col_group">'; }).join("")
      +             '</colgroup>'
      +             '<thead>'
      +               '<tr>'
      +                 '<th class="mk_mod_library_cell"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_toolbox_20_regular"></i> Narzędzia</th>'
      +                 stepsHead
      +               '</tr>'
      +             '</thead>'
      +             '<tbody>'
      +               '<tr>'
      +                 '<td class="mk_mod_library_cell">' + mk_mod_renderLeftCellContent() + '</td>'
      +                 stepsBody
      +               '</tr>'
      +             '</tbody>'
      +           '</table>'
      +         '</div>'
      +       '</div>'

      +       '<div id="mk_mod_flow_view" class="' + (mk_mod_state.viewMode === "flow" ? "" : "mk_mod_view_hidden") + '" style="position: relative; overflow: hidden; width: 100%;">'
      +         '<div class="mk_mod_flow_workspace" id="mk_mod_flow_workspace_wrap" onmousemove="window.mk_mod_api.flowMouseMove(event)" onmouseup="window.mk_mod_api.flowMouseUp(event)" onmouseleave="window.mk_mod_api.flowMouseUp(event)">'
      +            '<div id="mk_mod_flow_workspace_inner" style="width:100%; height:100%;"></div>'
      +         '</div>'
      +         '<div id="mk_mod_flow_properties_container" class="mk_mod_flow_panel">'
      +            '<div class="mk_mod_flow_panel_head">'
      +                '<h3 id="mk_mod_flow_panel_title">Właściwości</h3>'
      +                '<button class="mk_mod_icon_btn" onclick="window.mk_mod_api.closeProps()" style="color:var(--mk_mod_text);"><i class="webcon-ui icon-ic_fluent icon-ic_fluent_dismiss_20_regular icon-ic_fluent__size--20"></i></button>'
      +            '</div>'
      +            '<div id="mk_mod_flow_panel_body" class="mk_mod_flow_panel_body"></div>'
      +         '</div>'
      +       '</div>'

      +     '</div>'
      +   '</div>'
      + '</div>';
    
    mk_mod_syncJson();
    
    if (mk_mod_state.viewMode === "flow") {
        mk_mod_renderFlow();
    }
  }

  // ==========================================
  // 7. GLOBALNE API DLA INLINE EVENTS
  // ==========================================
  window.mk_mod_api = {
      toggleView: function() {
          mk_mod_state.viewMode = mk_mod_state.viewMode === "form" ? "flow" : "form";
          mk_mod_state.selectedKind = null; 
          mk_mod_render();
      },
      toggleLock: function() {
          mk_mod_state.isLocked = !mk_mod_state.isLocked;
          if (mk_mod_state.isLocked) { mk_mod_state.selectedId = null; mk_mod_state.selectedKind = null; }
          mk_mod_render();
      },
      toggleFullscreen: function() {
          var appNode = document.getElementById("mk_mod_app");
          if (!appNode) return;
          if (!document.fullscreenElement) { if (appNode.requestFullscreen) appNode.requestFullscreen(); } 
          else { if (document.exitFullscreen) document.exitFullscreen(); }
      },
      clearEditor: function() {
          if (confirm("UWAGA: Usuniesz wszystkie dane i rozpoczniesz z czystą kartą. Czy na pewno?")) {
              mk_mod_state.model.steps = [{ id: mk_mod_uid("step"), name: "Krok Startowy", stepDescription: "", ui_x: 250, ui_y: 100, stepType: "start", items: [], paths: [] }];
              mk_mod_state.selectedId = null; mk_mod_state.selectedKind = null;
              mk_mod_render();
          }
      },
      toggleLeftPanel: function() {
          mk_mod_state.isLeftPanelCollapsed = !mk_mod_state.isLeftPanelCollapsed;
          mk_mod_render();
      },
      selectItem: function(e, id) {
          if (mk_mod_state.isLocked) return;
          e.stopPropagation();
          mk_mod_state.selectedKind = "item";
          mk_mod_state.selectedId = id;
          mk_mod_render();
      },
      deselectItem: function(e) {
          if (e) e.stopPropagation(); 
          mk_mod_state.selectedKind = null;
          mk_mod_state.selectedId = null;
          mk_mod_render();
      },
      removeItem: function(e, id) {
          e.stopPropagation();
          var found = mk_mod_findAnyItem(id);
          if (found) {
              found.array.splice(found.index, 1);
              if (mk_mod_state.selectedId === id) { mk_mod_state.selectedId = null; mk_mod_state.selectedKind = null; }
              mk_mod_render();
          }
      },
      extractItem: function(e, id) {
          e.stopPropagation();
          var found = mk_mod_findAnyItem(id);
          if (!found || !found.parentGroupId) return;
          var step = mk_mod_findStepById(found.stepId);
          if (!step) return;
          found.array.splice(found.index, 1);
          step.items.push(found.item);
          mk_mod_state.selectedId = found.item.id;
          mk_mod_state.selectedKind = "item";
          mk_mod_render();
      },
      saveProps: function(e) {
          if (e) e.stopPropagation(); 
          if (mk_mod_state.selectedKind === "item") {
              var found = mk_mod_findAnyItem(mk_mod_state.selectedId);
              if (found) {
                  if (found.item.kind === "group") {
                      found.item.title = document.getElementById("mk_mod_prop_group_title").value.trim();
                  } else {
                      found.item.label = document.getElementById("mk_mod_prop_field_label").value.trim();
                      found.item.required = document.getElementById("mk_mod_prop_field_required").checked;
                      found.item.isVisible = document.getElementById("mk_mod_prop_field_visible").checked;
                      found.item.isEditable = document.getElementById("mk_mod_prop_field_editable").checked;
                      found.item.placeholder = document.getElementById("mk_mod_prop_field_description").value.trim();
                  }
                  mk_mod_state.selectedKind = null;
                  mk_mod_state.selectedId = null;
                  mk_mod_render();
              }
          }
      },
      copyStepItems: function(stepId) {
          var step = mk_mod_findStepById(stepId);
          if(step) {
              mk_mod_state.clipboardItems = mk_mod_clone(step.items);
              mk_mod_render(); 
          }
      },
      pasteStepItems: function(stepId) {
          if(!mk_mod_state.clipboardItems) return;
          var step = mk_mod_findStepById(stepId);
          if(step) {
              var newItems = mk_mod_clone(mk_mod_state.clipboardItems);
              newItems.forEach(function(item) { mk_mod_regenerateAllIdsForItem(item); });
              step.items = step.items.concat(newItems);
              mk_mod_syncJson();
              mk_mod_render();
          }
      },
      dragStartPalette: function(e, type) {
          if (mk_mod_state.isLocked) return;
          e.dataTransfer.setData("text/plain", JSON.stringify({ source: "palette", type: type }));
      },
      dragStartMove: function(e, id) {
          if (mk_mod_state.isLocked) return;
          e.dataTransfer.setData("text/plain", JSON.stringify({ source: "move_item", id: id }));
          e.stopPropagation();
      },
      dragOver: function(e) {
          if (!mk_mod_state.isLocked) { e.preventDefault(); e.currentTarget.classList.add("mk_mod_drag_over"); }
      },
      dragLeave: function(e) { e.currentTarget.classList.remove("mk_mod_drag_over"); },
      drop: function(e, stepId, containerId, targetIndex) {
          if (mk_mod_state.isLocked) return;
          e.preventDefault();
          e.currentTarget.classList.remove("mk_mod_drag_over");
          var raw = e.dataTransfer.getData("text/plain");
          if (!raw) return;
          var payload; try { payload = JSON.parse(raw); } catch (err) { return; }
          
          var targetArray = mk_mod_getTargetArray(stepId, containerId);
          if (!targetArray) return;
          
          if (payload.source === "palette") {
              if (payload.type === "group" && containerId !== "root") { alert("Nie możesz zagnieździć grupy w grupie."); return; }
              var newItem = payload.type === "group" ? mk_mod_createDefaultGroup() : mk_mod_createDefaultField(payload.type);
              targetArray.splice(targetIndex, 0, newItem);
              mk_mod_state.selectedKind = "item"; mk_mod_state.selectedId = newItem.id;
              mk_mod_render();
          } else if (payload.source === "move_item" && payload.id) {
              var foundMoving = mk_mod_findAnyItem(payload.id);
              if (foundMoving && foundMoving.item.kind === "group" && containerId !== "root") { alert("Nie możesz zagnieździć grupy w grupie."); return; }
              
              var movingItem = foundMoving.item;
              if (movingItem.kind === "group" && targetArray === movingItem.items) return;
              foundMoving.array.splice(foundMoving.index, 1);
              if (foundMoving.array === targetArray && foundMoving.index < targetIndex) targetIndex--;
              if (targetIndex < 0) targetIndex = 0;
              if (targetIndex > targetArray.length) targetIndex = targetArray.length;
              targetArray.splice(targetIndex, 0, movingItem);
              mk_mod_render();
          }
      },
      addFlow: function(type) {
          var ws = document.getElementById("mk_mod_flow_workspace");
          var scrollLeft = ws ? ws.scrollLeft : 0; var scrollTop = ws ? ws.scrollTop : 0;
          var newStep = { id: mk_mod_uid("step"), name: "Nowy krok", stepDescription: "", ui_x: scrollLeft + 200 + Math.floor(Math.random() * 50), ui_y: scrollTop + 100 + Math.floor(Math.random() * 50), stepType: type, items: [], paths: [] };
          mk_mod_state.model.steps.push(newStep);
          mk_mod_state.selectedKind = 'step'; mk_mod_state.selectedId = newStep.id;
          mk_mod_syncJson(); mk_mod_renderFlow();
      },
      selectPath: function(e, id) {
          e.stopPropagation();
          mk_mod_state.selectedKind = 'path'; mk_mod_state.selectedId = id;
          mk_mod_renderFlowPanel();
          document.querySelectorAll('.mk_mod_flow_node').forEach(function(n) { n.classList.remove('mk_mod_flow_node_selected'); });
          document.querySelectorAll('.mk_mod_flow_path_overlay').forEach(function(n) { n.classList.remove('mk_mod_selected'); });
          e.currentTarget.classList.add('mk_mod_selected');
          mk_mod_renderFlowPaths();
      },
      closeProps: function() {
          mk_mod_state.selectedKind = null; mk_mod_state.selectedId = null;
          mk_mod_renderFlowPanel();
          document.querySelectorAll('.mk_mod_flow_node_selected').forEach(function(n) { n.classList.remove('mk_mod_flow_node_selected'); });
          document.querySelectorAll('.mk_mod_selected').forEach(function(n) { n.classList.remove('mk_mod_selected'); });
          mk_mod_renderFlowPaths();
      },
      deleteLive: function(btn) {
          if (btn.getAttribute('data-confirm') !== '1') {
              btn.setAttribute('data-confirm', '1');
              btn.innerHTML = '<i class="webcon-ui icon-ic_fluent icon-ic_fluent_warning_20_regular icon-ic_fluent__size--20"></i> Kliknij ponownie, aby usunąć';
              btn.classList.add('mk_mod_btn_danger_confirm');
              setTimeout(function() {
                  if (document.body.contains(btn)) {
                      btn.removeAttribute('data-confirm'); btn.classList.remove('mk_mod_btn_danger_confirm');
                      btn.innerHTML = '<i class="webcon-ui icon-ic_fluent icon-ic_fluent_delete_20_regular icon-ic_fluent__size--20"></i> ' + (mk_mod_state.selectedKind === 'step' ? 'Usuń krok' : 'Usuń połączenie');
                  }
              }, 3000);
          } else {
              if (mk_mod_state.selectedKind === 'step') {
                  if (mk_mod_state.model.steps.length <= 1) { alert("Musisz zostawić przynajmniej jeden krok."); return; }
                  mk_mod_removeStep(mk_mod_state.selectedId);
              } else if (mk_mod_state.selectedKind === 'path') {
                  mk_mod_removeSelectedPath();
              }
              mk_mod_renderFlow();
          }
      },
      liveUpdate: function(id, val) {
          if (mk_mod_state.isLocked) return;
          if (id === 'mk_mod_live_name') {
              if (mk_mod_state.selectedKind === 'step') {
                  var step = mk_mod_findStepById(mk_mod_state.selectedId);
                  if (step) { step.name = val || 'Brak nazwy'; var lbl = document.getElementById('mk_mod_node_lbl_' + step.id); if (lbl) lbl.textContent = step.name; }
              } else if (mk_mod_state.selectedKind === 'path') {
                  var found = mk_mod_findPathById(mk_mod_state.selectedId);
                  if (found) { found.path.name = val || 'Brak nazwy'; var plbl = document.getElementById('mk_mod_path_lbl_' + found.path.id); if (plbl) plbl.textContent = found.path.name; }
              }
          }
          else if (id === 'mk_mod_live_desc') { var sStep = mk_mod_findStepById(mk_mod_state.selectedId); if (sStep) sStep.stepDescription = val; }
          else if (id === 'mk_mod_live_assignee') { var fPath1 = mk_mod_findPathById(mk_mod_state.selectedId); if (fPath1) fPath1.path.assignee = val; }
          else if (id === 'mk_mod_live_action') { var fPath2 = mk_mod_findPathById(mk_mod_state.selectedId); if (fPath2) fPath2.path.action = val; }
          else if (id === 'mk_mod_live_color') {
              var fPathColor = mk_mod_findPathById(mk_mod_state.selectedId);
              if (fPathColor) { fPathColor.path.color = val; mk_mod_renderFlowPaths(); }
          }
          mk_mod_syncJson();
      },
      flowNodeMouseDown: function(e, stepId) {
          if (mk_mod_state.isLocked || mk_mod_state.viewMode !== 'flow') return;
          if (e.button !== 0) return; 
          e.stopPropagation();

          mk_mod_state.selectedKind = 'step';
          mk_mod_state.selectedId = stepId;
          mk_mod_renderFlowPanel();

          document.querySelectorAll('.mk_mod_flow_node').forEach(function(n){ n.classList.remove('mk_mod_flow_node_selected'); });
          document.querySelectorAll('.mk_mod_flow_path_overlay').forEach(function(n){ n.classList.remove('mk_mod_selected'); });
          e.currentTarget.classList.add('mk_mod_flow_node_selected');
          mk_mod_renderFlowPaths();

          mk_mod_state.dragNode.active = true;
          mk_mod_state.dragNode.stepId = stepId;
          mk_mod_state.dragNode.startX = e.clientX;
          mk_mod_state.dragNode.startY = e.clientY;
          var step = mk_mod_findStepById(stepId);
          mk_mod_state.dragNode.initialX = step ? step.ui_x : 0;
          mk_mod_state.dragNode.initialY = step ? step.ui_y : 0;
          e.currentTarget.style.zIndex = 100;
      },
      flowPortMouseDown: function(e, stepId) {
          if (mk_mod_state.isLocked || mk_mod_state.viewMode !== 'flow') return;
          if (e.button !== 0) return;
          e.stopPropagation();

          var wsWrap = document.getElementById("mk_mod_flow_workspace_wrap");
          var rct = wsWrap.getBoundingClientRect();
          mk_mod_state.linkNode.active = true;
          mk_mod_state.linkNode.sourceId = stepId;
          mk_mod_state.linkNode.startX = e.clientX - rct.left + wsWrap.scrollLeft;
          mk_mod_state.linkNode.startY = e.clientY - rct.top + wsWrap.scrollTop;
          mk_mod_state.linkNode.currentX = mk_mod_state.linkNode.startX;
          mk_mod_state.linkNode.currentY = mk_mod_state.linkNode.startY;
          mk_mod_renderFlowPaths();
      },
      flowMouseMove: function(e) {
          if (!mk_mod_state.dragNode.active && !mk_mod_state.linkNode.active) return;

          var wsWrap = document.getElementById("mk_mod_flow_workspace_wrap");
          if (!wsWrap) return;
          var rct = wsWrap.getBoundingClientRect();
          var currentX = e.clientX - rct.left + wsWrap.scrollLeft;
          var currentY = e.clientY - rct.top + wsWrap.scrollTop;

          if (mk_mod_state.dragNode.active) {
              var step = mk_mod_findStepById(mk_mod_state.dragNode.stepId);
              if (!step) return;
              var dx = e.clientX - mk_mod_state.dragNode.startX;
              var dy = e.clientY - mk_mod_state.dragNode.startY;
              var newX = mk_mod_state.dragNode.initialX + dx;
              var newY = mk_mod_state.dragNode.initialY + dy;
              if (newX < 0) newX = 0; if (newY < 0) newY = 0;
              step.ui_x = newX; step.ui_y = newY;
              var el = document.querySelector('[data-mk-mod-flow-step="' + step.id + '"]');
              if (el) { el.style.left = newX + "px"; el.style.top = newY + "px"; }
              mk_mod_renderFlowPaths();
          }

          if (mk_mod_state.linkNode.active) {
              mk_mod_state.linkNode.currentX = currentX;
              mk_mod_state.linkNode.currentY = currentY;
              mk_mod_renderFlowPaths();
          }
      },
      flowMouseUp: function(e) {
          if (mk_mod_state.dragNode.active) {
              mk_mod_state.dragNode.active = false;
              var el = document.querySelector('[data-mk-mod-flow-step="' + mk_mod_state.dragNode.stepId + '"]');
              if (el) el.style.zIndex = 10;
              mk_mod_syncJson();
          }
          if (mk_mod_state.linkNode.active) {
              var node = e.target.closest('.mk_mod_flow_node');
              if (node) {
                  var targetId = node.getAttribute('data-mk-mod-flow-step');
                  if (targetId && targetId !== mk_mod_state.linkNode.sourceId) {
                      var sourceStep = mk_mod_findStepById(mk_mod_state.linkNode.sourceId);
                      if (sourceStep) {
                          var newPathId = mk_mod_uid("path");
                          sourceStep.paths.push({ id: newPathId, name: "Nowa ścieżka", assignee: "", action: "", targetStepId: targetId, color: "default" });
                          mk_mod_state.selectedKind = 'path';
                          mk_mod_state.selectedId = newPathId;
                          mk_mod_syncJson();
                          mk_mod_renderFlow(); 
                      }
                  }
              }
              mk_mod_state.linkNode.active = false;
              mk_mod_renderFlowPaths();
          }
      }
  };

  // ==========================================
  // 9. Funkcja synchronizująca lock formularza wizualnego z formularzem
  // ==========================================
  window.mk_mod_isFormEditable = function () {
      if (!window.WEBCON || !WEBCON.Forms || !WEBCON.Forms.FormState) {
          console.log("WEBCON.Forms.FormState niedostępny");
          return false;
      }
      if (WEBCON.Forms.FormState.IsEditMode === true) {
          return true;
      } else {
          return false;
      }
  };

  // ==========================================
  // 8. INICJALIZACJA APLIKACJI
  // ==========================================
  mk_mod_loadModelFromWebcon();
  mk_mod_state.isLocked = !window.mk_mod_isFormEditable();
  mk_mod_render();
})();
</script>
