  function mk_mod_renderFlowPaths() {
    var svg = document.getElementById("mk_mod_flow_svg");
    var overlays = document.getElementById("mk_mod_flow_overlays");
    if (!svg || !overlays) return;
    
    var html = '<defs>';
    Object.keys(mk_mod_path_colors).forEach(function(key) {
        html += '<marker id="mk_mod_arrow_' + key + '" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="' + mk_mod_path_colors[key] + '" /></marker>';
    });
    html += '</defs>';
    var overlaysHtml = '';

    mk_mod_state.model.steps.forEach(function(step) {
      var el1 = document.querySelector('[data-mk-mod-flow-step="' + step.id + '"]');
      if (!el1) return;
      var x1 = step.ui_x + el1.offsetWidth / 2; var y1 = step.ui_y + el1.offsetHeight / 2;

      step.paths.forEach(function(path) {
        if (!path.targetStepId) return;
        var targetStep = mk_mod_findStepById(path.targetStepId); if (!targetStep) return;
        var el2 = document.querySelector('[data-mk-mod-flow-step="' + targetStep.id + '"]'); if (!el2) return;

        var x2 = targetStep.ui_x + el2.offsetWidth / 2; var y2 = targetStep.ui_y + el2.offsetHeight / 2;
        var W = el2.offsetWidth; var H = el2.offsetHeight;
        var intPt = getArrowIntersection(x1, y1, x2, y2, W, H, targetStep.stepType === 'gateway');

        var isSelected = mk_mod_state.selectedKind === "path" && mk_mod_state.selectedId === path.id;
        var strokeColor = mk_mod_path_colors[path.color] || mk_mod_path_colors['default'];
        var className = isSelected ? "mk_mod_flow_path mk_mod_flow_path_selected" : "mk_mod_flow_path";

        html += '<path class="' + className + '" d="M ' + x1 + ' ' + y1 + ' L ' + intPt.x + ' ' + intPt.y + '" stroke="' + strokeColor + '" marker-end="url(#mk_mod_arrow_' + path.color + ')" />';
        
        var mx = (x1 + intPt.x) / 2; var my = (y1 + intPt.y) / 2;
        var selClass = isSelected ? ' mk_mod_selected' : '';
        overlaysHtml += '<div class="mk_mod_flow_path_overlay' + selClass + '" style="left:' + mx + 'px; top:' + my + 'px;" onclick="window.mk_mod_api.selectPath(event, \'' + path.id + '\')"><span id="mk_mod_path_lbl_' + path.id + '">' + mk_mod_escapeHtml(path.name) + '</span></div>';
      });
    });

    if (mk_mod_state.linkNode.active) {
       html += '<line x1="' + mk_mod_state.linkNode.startX + '" y1="' + mk_mod_state.linkNode.startY + '" x2="' + mk_mod_state.linkNode.currentX + '" y2="' + mk_mod_state.linkNode.currentY + '" stroke="#9ca3af" stroke-width="2" stroke-dasharray="6" marker-end="url(#mk_mod_arrow_default)" />';
    }

    svg.innerHTML = html;
    overlays.innerHTML = overlaysHtml;
  }

